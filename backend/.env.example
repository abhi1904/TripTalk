# Agora Console -> Project -> App ID / App Certificate
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional. Agora Console -> your username (bottom of sidebar) -> RESTful API Keys.
# Leave empty to authenticate with a token built from the App ID + Certificate instead.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# Google AI Studio key (Gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Text-to-speech: microsoft (Azure Speech) or elevenlabs
TTS_VENDOR=microsoft
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_VOICE_NAME=en-US-AndrewMultilingualNeural
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
